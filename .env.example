# Credenciales: crea .env a partir de este archivo y completa los valores.
TELEGRAM_BOT_TOKEN=PEGA_AQUI_TU_TOKEN_NUEVO
TELEGRAM_CHANNEL_ID=@TU_CANAL_DE_VIDEOJUEGOS
RAWG_API_KEY=PEGA_AQUI_TU_API_KEY_RAWG
# Código privado para vincular tu Telegram como administrador (elige uno largo)
ADMIN_SETUP_CODE=CAMBIA_ESTE_CODIGO_POR_UNO_SECRETO

# Publicación (20 publicaciones/día, de 09:00 a 21:00, cada 36 minutos)
PUBLICATIONS_PER_DAY=20
PUBLISH_START_HOUR=9
PUBLISH_END_HOUR=21
PUBLISH_INTERVAL_MINUTES=36
TIMEZONE=Europe/Madrid

# Catálogo RAWG
RAWG_PAGE_SIZE=40
RAWG_FETCH_INTERVAL_SECONDS=240
